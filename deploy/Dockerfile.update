# Update an existing, tested Vehicle Tracking runtime without duplicating PyTorch.
# See deploy/README.md; RUNTIME_IMAGE must be an existing project image on this host.
ARG RUNTIME_IMAGE
FROM ${RUNTIME_IMAGE}

USER root
WORKDIR /app
ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.revision=${SOURCE_COMMIT}
COPY README.md pyproject.toml constraints.txt ./
COPY src/ src/
RUN python -m pip install --no-deps deep-sort-realtime==1.3.2 scipy==1.18.1 \
    && python -m pip install --no-deps --no-build-isolation -e '.[deepsort]' \
    && python -m pip check
COPY app.py ./
COPY configs/ configs/
COPY .streamlit/config.toml .streamlit/config.toml
USER 1000:1000
